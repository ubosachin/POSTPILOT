# ==============================================================================
# PostPilot — Enterprise Multi-Tenant SaaS Environment Configuration Template
# ==============================================================================

# --- 1. APPLICATION & SERVER CONFIGURATION ---
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# --- 2. PERSISTENCE & DATABASE ---
# MongoDB Atlas Connection String or local MongoDB instance.
# (If unreachable, PostPilot automatically activates its resilient in-memory fallback)
MONGODB_URI=mongodb://localhost:27017/postpilot

# --- 3. QUEUE & DISTRIBUTED WORKER (BULLMQ + REDIS) ---
# Redis URL for BullMQ persistent job queues.
# (If Redis is offline, background publishing runs via resilient in-process queue runner)
REDIS_URL=redis://localhost:6379

# --- 4. CRYPTOGRAPHY & SECURITY VAULT ---
# Minimum 32-character secret for signing JWT session tokens
JWT_SECRET=postpilot-dev-jwt-super-secret-key-32-chars-minimum

# 64-character hex string (32 bytes) for AES-256-GCM social credential vault encryption
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- 5. SOCIAL MEDIA PLATFORM GATEWAYS ---
# Bluesky AT Protocol service gateway
BLUESKY_SERVICE_URL=https://bsky.social

# X (Twitter) API v2 Credentials (Optional: sandbox simulation active when empty)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# --- 6. AI CONTENT GENERATION ENGINE ---
# Optional: Provide Google Gemini API Key or OpenAI API Key for real-time generative models.
# (If left empty, PostPilot's built-in intelligent multi-tone heuristics engine generates variants)
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- 7. BILLING & CREDIT RECHARGE GATEWAY (RAZORPAY) ---
# Razorpay API credentials for sandbox / production credit checkout & webhook verification
RAZORPAY_KEY_ID=rzp_test_sampleKey123
RAZORPAY_KEY_SECRET=sampleSecret456
RAZORPAY_WEBHOOK_SECRET=sampleWebhookSecret789
